<%- include('partials/head') %>
<%- include('partials/sidebar', { pagina: 'creditos', tituloPagina: 'Mercado de créditos' }) %>

<div class="page-heading">
  <div>
    <span class="eyebrow">CARBONMOB MARKETPLACE</span>
    <h2>Mercado de créditos de carbono</h2>
    <p>Encontre projetos e acompanhe os anúncios disponíveis.</p>
  </div>
  <% if (usuario.tipo === 'empresa') { %>
    <div class="heading-actions">
      <a class="btn btn-primary" href="/creditos/anunciar">+ Anunciar créditos</a>
    </div>
  <% } %>
</div>

<section class="panel">
  <div class="panel-head">
    <div>
      <h3>Encontre créditos</h3>
      <p>Pesquise por projeto, categoria e faixa de preço.</p>
    </div>
  </div>

  <form action="/creditos" method="GET" class="form-grid">
    <div class="field">
      <label for="busca">Pesquisar projeto</label>
      <input id="busca" name="busca" value="<%= filtros.busca %>" placeholder="Ex.: reflorestamento">
    </div>

    <div class="field">
      <label for="tipo">Categoria</label>
      <select id="tipo" name="tipo">
        <option value="">Todas</option>
        <% categorias.forEach((categoria) => { %>
          <option value="<%= categoria %>" <%= filtros.tipo === categoria ? 'selected' : '' %>>
            <%= categoria %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="preco">Ordenar preço</label>
      <select id="preco" name="preco">
        <option value="">Mais recentes</option>
        <option value="menor" <%= filtros.preco === 'menor' ? 'selected' : '' %>>Menor preço</option>
        <option value="maior" <%= filtros.preco === 'maior' ? 'selected' : '' %>>Maior preço</option>
      </select>
    </div>

    <div class="field" style="align-self:end">
      <button class="btn btn-primary" type="submit">Pesquisar</button>
    </div>
  </form>
</section>

<section class="panel">
  <div class="panel-head">
    <div>
      <h3>Créditos disponíveis</h3>
      <p>Os anúncios desta versão são demonstrativos e não representam uma negociação financeira real.</p>
    </div>
  </div>

  <% if (creditos.length > 0) { %>
    <div class="grid credit-grid">
      <% creditos.forEach((credito) => { %>
        <article class="feature-card credit-card">
          <span class="pill"><%= credito.categoria %></span>
          <h3><%= credito.projeto %></h3>
          <p class="muted"><%= credito.nome_empresa || 'Empresa vendedora' %></p>
          <p><%= credito.descricao %></p>
          <div class="credit-price">
            R$ <%= Number(credito.preco).toFixed(2).replace('.', ',') %> <small>/ crédito</small>
          </div>
          <p class="muted">
            <%= credito.quantidade_disponivel %> unidades disponíveis · <%= Number(credito.compensacao_kg).toFixed(2) %> kg CO₂ por unidade
          </p>

          <form action="/creditos/<%= credito.id %>/comprar" method="POST" class="buy-form">
            <label for="quantidade-<%= credito.id %>">Quantidade</label>
            <input
              id="quantidade-<%= credito.id %>"
              name="quantidade"
              type="number"
              min="1"
              max="<%= credito.quantidade_disponivel %>"
              value="1"
              required
            >
            <button class="btn btn-primary full" type="submit">Comprar (simulação)</button>
          </form>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <strong>Nenhum anúncio encontrado</strong>
      Empresas podem cadastrar novos projetos para disponibilizá-los no mercado.
    </div>
  <% } %>
</section>

<section class="panel">
  <div class="panel-head">
    <div>
      <h3>Movimentações recentes de preço</h3>
      <p>Histórico demonstrativo dos anúncios publicados e das compras realizadas.</p>
    </div>
  </div>

  <% if (historico.length > 0) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Projeto</th>
            <th>Preço registrado</th>
            <th>Movimento</th>
            <th>Data</th>
          </tr>
        </thead>
        <tbody>
          <% historico.forEach((item) => { %>
            <tr>
              <td><%= item.projeto %></td>
              <td>R$ <%= Number(item.preco).toFixed(2).replace('.', ',') %></td>
              <td><%= item.tipo_movimento %></td>
              <td><%= new Date(item.criado_em).toLocaleDateString('pt-BR') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <strong>Ainda não há movimentações</strong>
      O histórico será preenchido quando empresas publicarem anúncios.
    </div>
  <% } %>
</section>

<section class="panel market-note">
  <h3>Como funciona a variação de preços?</h3>
  <p>
    O preço inicial é definido pela empresa vendedora. Nesta simulação, conforme uma parte maior do estoque é comprada, o preço do anúncio pode subir gradualmente, limitado a 15% do valor inicial. O sistema registra cada movimentação para que os usuários acompanhem o histórico. É uma regra didática inspirada na oferta e na procura, não uma cotação de bolsa real.
  </p>
</section>

<%- include('partials/footer') %>
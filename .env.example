# Fatores de emissão preservados como valores provisórios do projeto.
# Consumo de ônibus: referência Transurc de 2,5 km/L para ônibus convencional em uma linha de Campinas.
# Ocupação de 30 passageiros: hipótese de demonstração, não dado oficial da frota.
GASOLINE_FACTOR=2.2
ETHANOL_FACTOR=0.2
DIESEL_FACTOR=2.6
BUS_DIESEL_KM_PER_L=2.5
BUS_AVERAGE_PASSENGERS=30
